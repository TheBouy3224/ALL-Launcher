<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud / adb backup is disabled (allowBackup=false). These rules stay as a second line of defence for tools that still read them:
    nothing is included, so accounts, tokens, settings, instances and worlds never leave the device through Android backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
